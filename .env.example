# 복사해서 .env 로 쓴다. .env 는 커밋되지 않는다.

# ── LLM ───────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 관측 (02 §10) ─────────────────────────────────────────
# ⚠️ D-36 — 트레이스는 입력 원문을 저장한다. 데모 전에 가명화를 켠다.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=pettriage
LANGCHAIN_HIDE_INPUTS=true
LANGCHAIN_HIDE_OUTPUTS=true

# ── 경로 ──────────────────────────────────────────────────
DATA_DIR=./data
VECTORSTORE_DIR=./.chroma

# ── 설정으로 옮긴 값들 ────────────────────────────────────
# 모델·임베딩·top-k·임계값은 configs/*.yaml 에 있다 (재현에 필요하므로 커밋된다).
# 여기에는 비밀과 환경차이만 둔다.

# ── 단발 오버라이드 ───────────────────────────────────────
# 이중 밑줄로 configs 값을 덮는다. 파일을 고치지 않고 한 번만 바꿀 때.
#   PETTRIAGE__RETRIEVAL__TOP_K=8
#   PETTRIAGE__SERVE__ENGINE=graph

# ── 컨테이너 (compose.yaml) ───────────────────────────────
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://pettriage:changeme@localhost:5432/pettriage

# ── 프로파일 ──────────────────────────────────────────────
# configs/<이름>.yaml 을 default.yaml 위에 덮는다 (default / train / eval)
PETTRIAGE_PROFILE=default
