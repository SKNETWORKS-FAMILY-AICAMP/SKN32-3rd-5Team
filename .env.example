# 복사해서 .env 로 쓴다. .env 는 커밋되지 않는다.

# ── LLM ───────────────────────────────────────────────────
# ⚠️ **어느 모델로 답할지는 여기서 정하지 않는다** — `configs/*.yaml` 의
#    `model.provider` 다 (D-65 · 04 §3 비교군). 여기에는 **키만** 둔다.
#
# OPENAI_API_KEY 는 OpenAI 호환 엔드포인트의 키로도 쓰인다 —
# Qwen3-4B 를 호스팅 API 로 부를 때(Together·Fireworks·DeepInfra 등)
# 그 사업자 키를 여기 넣고 `model.api_base_url` 을 그쪽으로 돌린다.
# 비어 있으면 5태스크가 전부 폴백으로 돈다 (경고 로그가 남는다).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 관측 (02 §10) ─────────────────────────────────────────
# ⚠️ D-36 — 트레이스는 입력 원문을 저장한다. 데모 전에 가명화를 켠다.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=pettriage
LANGCHAIN_HIDE_INPUTS=true
LANGCHAIN_HIDE_OUTPUTS=true

# ── 경로 ──────────────────────────────────────────────────
DATA_DIR=./data
VECTORSTORE_DIR=./.chroma

# ── 설정으로 옮긴 값들 ────────────────────────────────────
# 모델·임베딩·top-k·임계값은 configs/*.yaml 에 있다 (재현에 필요하므로 커밋된다).
# 여기에는 비밀과 환경차이만 둔다.

# ── 단발 오버라이드 ───────────────────────────────────────
# 이중 밑줄로 configs 값을 덮는다. 파일을 고치지 않고 한 번만 바꿀 때.
#
# ✅ **이 파일(.env)에 적어도 먹는다** — 2026-08-02 까지는 안 먹었다 (D-69).
#    `_env_overrides` 가 `os.environ` 만 봤고, pydantic-settings 는 .env 를
#    `os.environ` 에 내보내지 않는다. 아래 예시들이 **한 번도 동작하지 않았다.**
#    셸 변수가 이 파일보다 우선한다 — 한 번짜리가 상시를 이겨야 비교군을 갈아끼운다.
#
# ⚠️ 없는 키를 적으면 `UnknownConfigKey` 로 **기동이 멈춘다.** 조용히 무시하지 않는다.
#    `tests/test_config_is_read.py` 가 이 파일의 키가 실재하는지도 검사한다.
#   PETTRIAGE__RETRIEVAL__TOP_K=8
#   PETTRIAGE__SERVE__ENGINE=graph
#
# 04 §3 비교군을 갈아끼우는 자리다. **덮은 값은 로그와 리포트에 남는다** (04 §8).
#
#   기준선 (모델 없음 — 5태스크 전부 폴백)
#     PETTRIAGE__MODEL__PROVIDER=none
#
#   비교군 A (대형 LLM)
#     PETTRIAGE__MODEL__PROVIDER=api
#     PETTRIAGE__MODEL__API_MODEL=gpt-4o-mini
#
#   비교군 D (Qwen3-4B 베이스 — 로컬 로드. 첫 호출에 HF 에서 자동 내려받는다)
#     PETTRIAGE__MODEL__PROVIDER=qwen
#     · VRAM  bf16 ≈ 9GB / 4bit ≈ 3.5GB (configs 의 load_in_4bit)
#     · 필요   pip install accelerate bitsandbytes    (없으면 폴백 + 경고)
#     · GPU 없으면 float32/CPU 로 떨어진다 — 60건 × 6회는 몇 시간이다
#
#   비교군 D(4bit) — 미리 양자화된 가중치. **GPU 문턱이 3.5GB 로 내려간다**
#     PETTRIAGE__MODEL__PROVIDER=qwen
#     PETTRIAGE__MODEL__BASE_ID=unsloth/Qwen3-4B-unsloth-bnb-4bit
#     PETTRIAGE__MODEL__REVISION=null          ← **함께 비우거나 그 저장소 커밋으로.**
#                                                 안 바꾸면 설정 검증이 막는다 (404 방지)
#     ⚠️ 원 저장소 revision 핀이 적용되지 않는다. 04 §8 에 실제 커밋을 기록할 것.
#
#   비교군 C (Qwen3-4B + LoRA 어댑터)
#     PETTRIAGE__MODEL__PROVIDER=qwen
#     PETTRIAGE__MODEL__ADAPTER_PATH=artifacts/adapters/qwen3-4b-mt
#
#   비교군 D 근사 (Qwen3-4B 호스팅 API — GPU 없이)
#     PETTRIAGE__MODEL__PROVIDER=api
#     PETTRIAGE__MODEL__API_BASE_URL=https://api.together.xyz/v1
#     PETTRIAGE__MODEL__API_MODEL=Qwen/Qwen3-4B
#     ⚠️ 사업자 가중치의 revision·양자화를 확인할 수 없어 `model.revision`
#        (1cfa9a72…) 핀이 걸리지 않는다. 리포트에 `D(근사·호스팅)` 로 적는다.

# ── 컨테이너 (compose.yaml) ───────────────────────────────
# ⚠ DATABASE_URL 이 **설정되면** auth/pets 라우터가 켜진다.
#   그때 '.[db]' 가 안 깔려 있으면 앱이 기동을 멈춘다 — 조용히 인증 없이 뜨지 않는다.
#     pip install -e '.[api,db]' -c constraints.txt
#   DB 없이 RAG 만 쓸 거면 이 줄을 비워 둔다.
# MySQL 은 로컬에 설치하지 않는다 — `docker compose up db` 로 띄운다 (D-48).
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root
DATABASE_URL=mysql+pymysql://pettriage:changeme@localhost:3306/pettriage

# ── 인증 (D-41 — 비밀만 여기, 만료·알고리즘은 configs/default.yaml) ──
# 기본값이 없다. 없으면 토큰 발급이 JWTKeyMissingError 로 실패한다.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# ── 프로파일 ──────────────────────────────────────────────
# configs/<이름>.yaml 을 default.yaml 위에 덮는다 (default / train / eval)
#
# ⚠️ 평가는 반드시 `eval` 로 돈다 — `serve.engine: graph` 뿐 아니라
#    `max_clarify_turns: 0` 도 거기서 온다. 되묻기가 섞이면 과소평가율
#    분모가 흔들린다 (04 §4.1). `--engine graph` 만으로는 그것이 안 꺼진다.
PETTRIAGE_PROFILE=default
