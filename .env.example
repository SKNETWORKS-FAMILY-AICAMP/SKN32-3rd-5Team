# ══════════════════════════════════════════════════════════════
#  .env  — 복사해서 쓴다. **커밋되지 않는다** (.gitignore).
#
#      PowerShell   Copy-Item .env.example .env
#      bash         cp .env.example .env
#
#  ⚠️ 저장은 **UTF-8(BOM 없음)** 또는 ANSI. PowerShell 의 기본 `utf8` 은 BOM 을
#     붙이고, 그러면 첫 줄 키가 `﻿OPENAI_API_KEY` 로 읽혀 **조용히 안 먹는다.**
#         '...' | Set-Content .env -Encoding ascii
# ══════════════════════════════════════════════════════════════


# ══ 1. 지금 채울 것 ═══════════════════════════════════════════

# LLM 키. **OpenAI 호환 엔드포인트면 그 사업자 키를 여기 넣는다** —
# Gemini · OpenRouter · Together · Fireworks 전부 이 칸을 쓴다.
# 비어 있으면 5태스크가 전부 폴백으로 돈다 (경고 로그가 남는다).
OPENAI_API_KEY=


# ══ 2. 어느 모델로 부를까 — **하나만 골라 주석을 푼다** ═══════
#
# ⚠️ `PROVIDER` 는 여기 적지 않는다. 비교군은 `--arm` 이 고른다 (아래 3번).
#    여기에는 **엔드포인트와 모델 이름만** 둔다.

# ── Google Gemini (무료 티어 O · GPU 없이 됨) ──
#PETTRIAGE__MODEL__API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#PETTRIAGE__MODEL__API_MODEL=gemini-3.5-flash

# ── OpenAI 본가 (base_url 없음) ──
#PETTRIAGE__MODEL__API_MODEL=gpt-4o-mini

# ── Qwen3-4B 호스팅 = 비교군 D 근사 (GPU 없이 우리 배포 모델 계열) ──
#   ⚠️ 사업자 가중치의 revision·양자화를 확인할 수 없다.
#      리포트에 `D(근사·호스팅)` 로 적는다 (04 §8).
#PETTRIAGE__MODEL__API_BASE_URL=https://openrouter.ai/api/v1
#PETTRIAGE__MODEL__API_MODEL=qwen/qwen3-4b

# ── Qwen3-4B 로컬 (GPU 필요 · `pip install -e '.[api,rag,qwen,dev]'`) ──
#   VRAM  bf16 ≈9GB / 4bit ≈3.5GB
#   ⚠️ CPU 로는 4B 추론이 사실상 불가하다 (2026-08-02 실측 — 실행 중 실패).
#      `model.revision` 핀도 현재 유효하지 않다 (04 §8).
#   비교군 C 는 어댑터 경로까지 준다 —
#PETTRIAGE__MODEL__ADAPTER_PATH=artifacts/adapters/qwen3-4b-mt


# ── 🔴 호출 간격 (ms) — **무료·저등급 키면 반드시 켠다** ──
#   하네스는 질의 하나에 LLM 을 6번 부르고 60건을 쉬지 않고 돈다.
#   그대로 두면 순간 분당 100회를 넘겨 **429 가 쏟아지고 실행이 멈춘다**
#   (2026-08-02 Gemini 실측 — 재시도 8회를 다 쓰고도 실패).
#
#     10 RPM → 6000    (60건이 ~36분. 무료 티어의 바닥이다)
#     60 RPM → 1000    (~6분)
#     유료·상위 → 0     (제한 없음. 기본값)
#
#   ⚠️ **셸(`$env:…`)에 적으면 안 된다.** `--arm` 이 `PETTRIAGE__MODEL__*` 를
#      전부 비우고 시작하므로 지워진다 (아래 3번). 상시 설정은 여기 둔다.
#PETTRIAGE__MODEL__MIN_INTERVAL_MS=6000


# ══ 3. 실행 ═══════════════════════════════════════════════════
#
#   $env:PETTRIAGE_PROFILE="eval"          ← 🔴 **셸에서만 먹는다** (아래 5번)
#   python scripts/smoke_llm.py --arm A                        # 환경 점검
#   python eval/harness/run_eval.py --arm A --json eval/reports/2026-08-03_A.json
#
#   --arm  none   LLM 없음 — 5태스크 전부 폴백 (기준선)
#          A      대형 LLM · openai SDK 직접
#          A-LC   같은 모델을 **LangChain 으로** (D-71)
#          D      Qwen3-4B 베이스 (로컬)
#          C      Qwen3-4B + LoRA 어댑터
#
# ⚠️ `--arm` 은 **셸의 `PETTRIAGE__MODEL__…` 를 전부 비우고** 시작한다.
#    앞 실험이 다음 측정에 새어 들지 않게 하려는 것이다.
#    **그래서 상시 설정은 셸이 아니라 이 파일에 둔다** — 여기 값은 살아남는다.


# ══ 4. 필요할 때만 ════════════════════════════════════════════

# ── 관측 (02 §10) ──
# ⚠️ D-36 — 트레이스는 입력 원문을 저장한다. 데모 전에 가명화를 켠다.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=pettriage
LANGCHAIN_HIDE_INPUTS=true
LANGCHAIN_HIDE_OUTPUTS=true

# ── 경로 ──
DATA_DIR=./data
VECTORSTORE_DIR=./.chroma

# ── DB (회원가입·프로필. RAG 만 쓰면 건드리지 않는다) ──
# 🔴 **`DATABASE_URL` 은 비워 둔다.** 값이 있으면 auth/pets 라우터가 켜지고,
#    `.[db]` 가 안 깔려 있으면 **앱이 기동을 멈춘다** (조용히 인증 없이 뜨지 않는다).
#      pip install -e '.[api,db]' -c constraints.txt
#    MySQL 은 로컬에 설치하지 않는다 — `docker compose up db` (D-48).
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root
#DATABASE_URL=mysql+pymysql://pettriage:changeme@localhost:3306/pettriage

# ── 인증 (D-41 — 비밀만 여기. 만료·알고리즘은 configs/default.yaml) ──
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# ── 그 밖의 단발 오버라이드 ──
#   이중 밑줄로 `configs/*.yaml` 값을 덮는다.
#PETTRIAGE__RETRIEVAL__TOP_K=8
#PETTRIAGE__SERVE__ENGINE=graph


# ══ 5. 왜 이렇게 돼 있나 (읽지 않아도 된다) ═══════════════════
#
# ✅ **이 파일의 `PETTRIAGE__…` 는 실제로 먹는다.** 2026-08-02 까지는 안 먹었다 —
#    `_env_overrides` 가 `os.environ` 만 봤고 pydantic-settings 는 `.env` 를
#    `os.environ` 에 내보내지 않는다. `extra="ignore"` 라 **경고도 없이 버려졌다.**
#    위 예시들이 한 번도 동작한 적이 없었다 (D-69).
#    셸 변수가 이 파일보다 우선한다 — 한 번짜리가 상시를 이겨야 비교군을 갈아끼운다.
#
# 🔴 **`PETTRIAGE_PROFILE` 은 예외다.** 밑줄이 하나라 오버라이드로 안 잡히고,
#    `get_config()` 는 셸 환경변수만 본다. **`.env` 에 적으면 안 먹는다.**
#
# ⚠️ 없는 키를 적으면 `UnknownConfigKey` 로 **기동이 멈춘다.** 조용히 무시하지 않는다.
#    `tests/test_config_is_read.py` 가 이 파일의 키가 실재하는지도 검사한다.
#
# ℹ️ 평가는 `eval` 프로파일로 돈다 — `serve.engine: graph` 가 거기서 온다.
#    (예전 주석은 *"`max_clarify_turns: 0` 도 거기서 오고, 되묻기가 섞이면 분모가
#     흔들린다"* 였다. **D-66 에서 그 근거가 성립하지 않는 것이 드러나** 되묻기를
#     다시 켰다 — `clarify` 도 `refused` 도 등급 분모에서 똑같이 빠진다.)
#
# ℹ️ 모델·임베딩·top-k·임계값은 `configs/*.yaml` 에 있다 (재현에 필요해 커밋된다).
#    여기에는 **비밀과 환경 차이만** 둔다 (D-41).
