# ══════════════════════════════════════════════════════════════
#  .env  — 이 파일을 복사해서 쓴다. **커밋되지 않는다** (.gitignore).
#
#      python scripts/setup_env.py        ← 만들고 **검증까지** 한다 (권장)
#      Copy-Item .env.example .env        ← 손으로 할 때
#
#  ⚠️ **UTF-8(BOM 없음)** 으로 저장한다. PowerShell 의 기본 `utf8` 은 BOM 을 붙이고,
#     그러면 첫 줄 키가 `﻿OPENAI_API_KEY` 로 읽혀 **조용히 안 먹는다.**
# ══════════════════════════════════════════════════════════════


# ══ 1. 반드시 채운다 (두 줄) ══════════════════════════════════

# LLM 키. **OpenAI 호환 엔드포인트면 그 사업자 키를 여기 넣는다** —
# Gemini · OpenRouter · Together · Fireworks 전부 이 칸을 쓴다.
# 비어 있으면 5태스크가 전부 폴백으로 돈다 (경고 로그가 남는다).
OPENAI_API_KEY=

# 로그인 서명 키. **비어 있으면 로그인이 실패한다** (`JWTKeyMissingError`) —
# 약한 기본 키로 조용히 도는 것을 막으려고 일부러 예외를 낸다 (D-41).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=


# ══ 2. 그대로 두면 된다 ═══════════════════════════════════════

# 시연·개발용 SQLite — **설치가 필요 없다.** 스키마·코드는 MySQL 과 같고
# 드라이버는 코드가 아니라 이 URL 이 고른다 (`app/database.py` 머리말).
#   ⚠️ 값이 있으면 `.[db]` 가 필수다. 없으면 **앱이 기동을 멈춘다**(의도된 설계).
#   ⚠️ 테스트는 이 값을 보지 않는다 — `tests/conftest.py` 최상단이 비운다 (로컬 = CI).
DATABASE_URL=sqlite+pysqlite:///./pettriage.sqlite3

DATA_DIR=./data
VECTORSTORE_DIR=./.chroma


# ══ 3. 필요할 때만 ════════════════════════════════════════════

# ── 모델 바꾸기 — **하나만 골라 주석을 푼다** ──
#    ⚠️ `PROVIDER` 는 여기 적지 않는다. 비교군은 `--arm` 이 고른다.
#PETTRIAGE__MODEL__API_MODEL=gpt-4o-mini                     # OpenAI 본가 (base_url 없음)

#PETTRIAGE__MODEL__API_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#PETTRIAGE__MODEL__API_MODEL=gemini-3.5-flash                # Gemini · 무료 티어 O

#PETTRIAGE__MODEL__API_BASE_URL=https://openrouter.ai/api/v1
#PETTRIAGE__MODEL__API_MODEL=qwen/qwen3-4b                   # 비교군 D 근사 (04 §8)

#PETTRIAGE__MODEL__ADAPTER_PATH=artifacts/adapters/qwen3-4b-mt   # 비교군 C · GPU 필요

# 🔴 호출 간격(ms) — **무료·저등급 키면 반드시 켠다.**
#    하네스는 질의 하나에 LLM 을 6번 부르고 60건을 쉬지 않고 돈다. 그대로 두면
#    **429 가 쏟아지고 실행이 멈춘다** (2026-08-02 실측).
#      10 RPM → 6000 (60건 ~36분) · 60 RPM → 1000 (~6분) · 유료·상위 → 0 (기본)
#    ⚠️ 셸에 적으면 `--arm` 이 지운다. **상시 설정은 이 파일에 둔다.**
#PETTRIAGE__MODEL__MIN_INTERVAL_MS=6000

# ── MySQL (통합·운영). 로컬에 설치하지 않는다 — `docker compose up -d db` (D-48) ──
#DATABASE_URL=mysql+pymysql://pettriage:changeme@localhost:3306/pettriage
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme-root

# ── 관측 (02 §10). ⚠️ D-36 — 트레이스는 입력 원문을 저장한다 ──
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=pettriage
LANGCHAIN_HIDE_INPUTS=true
LANGCHAIN_HIDE_OUTPUTS=true

# ── `configs/*.yaml` 값 덮어쓰기 (이중 밑줄) ──
#PETTRIAGE__RETRIEVAL__TOP_K=8
#PETTRIAGE__SERVE__ENGINE=graph


# ══ 함정 셋 — 여기서 막히면 대개 이 중 하나다 ═════════════════
#
# 🔴 **`PETTRIAGE_PROFILE` 은 이 파일에 적으면 안 먹는다.** 밑줄이 하나라
#    오버라이드로 안 잡히고 `get_config()` 는 셸만 본다. 셸에서 세운다 —
#      $env:PETTRIAGE_PROFILE="eval"     ← 없으면 engine 이 **stub** 이다
#    (런처 `PetTriage_Launcher` 를 쓰면 자동으로 세워진다)
#
# 🔴 **셸 환경변수가 이 파일을 이긴다.** 셸에 빈 값이 남아 있으면 여기 값이 가려진다.
#      Remove-Item Env:OPENAI_API_KEY
#
# ⚠️ **없는 키를 적으면 `UnknownConfigKey` 로 기동이 멈춘다.** 조용히 무시하지 않는다.
#    `tests/test_config_is_read.py` 가 이 파일의 키가 실재하는지도 검사한다.
#
# ℹ️ 모델·임베딩·top-k·임계값은 `configs/*.yaml` 에 있다 (재현에 필요해 커밋된다).
#    여기에는 **비밀과 환경 차이만** 둔다 (D-41).
#    배경과 경위는 `docs/09_새환경-준비.md` · `docs/06` (D-41 · D-66 · D-69).
